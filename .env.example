# ==============================================================================
# Apify Google Maps Configuration (Actor: nwua9Gu5YrADL7ZDj - compass/crawler-google-places)
# ==============================================================================
# Provide your Apify API Token here (Personal API token from console.apify.com)
APIFY_API_TOKEN=your_apify_token_here

# Apify Actor ID (Default: nwua9Gu5YrADL7ZDj)
APIFY_ACTOR_ID=nwua9Gu5YrADL7ZDj

# Maximum places to extract per search query / location
MAX_RESULTS_PER_SEARCH=20

# Timeout in seconds for waiting for Apify Actor run to complete (default: 300s / 5 mins)
APIFY_RUN_TIMEOUT=300

# Language for Google Maps results (default: en)
APIFY_LANGUAGE=en

# Skip closed places (true/false)
APIFY_SKIP_CLOSED_PLACES=true

# ==============================================================================
# Airtable Configuration (Wizdom Pilot Base: appnKumhO07VlzUe8)
# ==============================================================================
# Personal Access Token (PAT) with data.records:read, data.records:write, schema.bases:read permissions
AIRTABLE_API_KEY=pat_your_token_here
AIRTABLE_BASE_ID=appnKumhO07VlzUe8
AIRTABLE_TABLE_NAME=tblLzZp1Gc0Pvyvo5
AIRTABLE_ZIPS_TABLE_NAME=tblu1CY9070zVsqot
AIRTABLE_DNC_TABLE_NAME=tblHhplF40Xc8FYQ7

# Safe Operating Mode:
# - dry_run (default): Simulates or scrapes, normalizes, qualifies, deduplicates, and logs preview. Zero Airtable writes.
# - live_discovery: Runs Apify discovery and pipeline, queries Airtable for deduplication/existing check, but DOES NOT write.
# - live_ingestion: Only writes eligible leads if explicitly enabled and confirmed.
EXECUTION_MODE=dry_run

# Strict safety flag: Live ingestion will REFUSE to write unless this is explicitly set to true
ENABLE_LIVE_INGESTION=false

# ==============================================================================
# Airtable Field Mapping (Internal Lead Field Name -> Airtable Column Name or Field ID)
